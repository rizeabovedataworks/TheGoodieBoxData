<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Card Shadow Layer -->
    <item
        android:bottom="0dp"
        android:left="2dp"
        android:right="2dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#28CDBCA4" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Aged Ivory Paper Base -->
    <item
        android:bottom="4dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#F7F1E3" />
            <stroke
                android:width="1.5dp"
                android:color="#E4D5BE" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Tea / Coffee Stain Gradient Accent -->
    <item
        android:bottom="4dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#00000000"
                android:endColor="#2AD8C5A4"
                android:startColor="#1CF5E9D5"
                android:type="linear" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Classic 3x5 Index Card Red Margin Rule Line -->
    <item
        android:left="14dp"
        android:right="14dp"
        android:top="40dp">
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#35C23B22" />
        </shape>
    </item>

</layer-list>
