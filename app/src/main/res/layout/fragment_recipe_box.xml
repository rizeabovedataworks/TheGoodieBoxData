<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Fixed Header: Open Recipe Box Lid & Horizontal Category Tabs -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="135dp"
        android:background="#3E2010"
        android:elevation="4dp">

        <!-- Layer 1: Open Recipe Box Lid Background -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Recipe Box Lid"
            android:scaleType="fitXY"
            android:src="@drawable/recipeboxlid_image" />

        <!-- Layer 2: Horizontal Category Index Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/categoryChipContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingTop="4dp" />

            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/recipe_box_rail_bg" />

        </LinearLayout>

    </FrameLayout>

    <!-- Interactive Recipe Box Viewport -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Layer 3: Inside Wooden Recipe Box Panel Background -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Inside Recipe Box Background"
            android:scaleType="centerCrop"
            android:src="@drawable/backrecipeboxpanel_img" />

        <!-- Recipe Cards Content (Scrolls inside the box) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="90dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp">

                <!-- Popular Recipes Header Row -->
                <TextView
                    android:id="@+id/tvSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/popular_recipes"
                    android:textColor="@color/title_brown"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Recipes List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewRecipes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_recipe" />

                <!-- Empty State Hint -->
                <TextView
                    android:id="@+id/tvEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="No recipes found in this category."
                    android:textColor="#7A6252"
                    android:textSize="15sp"
                    android:visibility="gone" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Layer 4: Front Face of Wooden Recipe Box (Tilts/Slides open on touch scroll) -->
        <ImageView
            android:id="@+id/ivFrontBoxFace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Recipe Box Front Face"
            android:elevation="3dp"
            android:scaleType="fitXY"
            android:src="@drawable/frontfacerecipebox_img" />

        <!-- Floating Scroll Down Affordance Button -->
        <ImageView
            android:id="@+id/fabScrollDown"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/fab_down_bg"
            android:clickable="true"
            android:contentDescription="Scroll Down"
            android:elevation="6dp"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_down" />

    </FrameLayout>

</LinearLayout>
